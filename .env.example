# Den Link bekommst du von Tobias oder Henri. Ohne ihn brechen die Läufe ab.
# Siehe data/README.md, Abschnitt „Eingangsdaten aus Google Drive“.
INPUTS_DRIVE_FOLDER_URL=

# Lesezugriff auf die KV-Datenbank der App Netzanpassungen (Schritt 3, netzanpassungen/apply_app_result.py
