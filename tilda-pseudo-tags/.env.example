# S3-Zugang für upload_s3.py. Die Werte stehen in der .env von tilda-geo
# (../tilda-geo/.env, Abschnitt S3): S3_KEY, S3_SECRET, S3_REGION, S3_BUCKET.
# Diese Datei nach .env kopieren und die Werte von dort übernehmen. .env ist nicht versioniert.
S3_KEY=
S3_SECRET=
S3_REGION=eu-central-1
S3_BUCKET=
